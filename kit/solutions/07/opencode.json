{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*.env": "deny"
    },
    "edit": {
      "*": "allow",
      "package.json": "ask"
    },
    "bash": {
      "*": "ask",
      "npm test": "allow",
      "npm run lint": "allow",
      "git status": "allow",
      "git diff*": "allow",
      "git push*": "deny"
    }
  }
}
