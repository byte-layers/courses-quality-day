{
  "permissions": {
    "deny": ["Read(./.env)", "Bash(git push:*)"],
    "ask": ["Edit(./package.json)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-guardrails.sh" }]
      }
    ]
  }
}
